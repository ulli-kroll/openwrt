#!/bin/sh

. /lib/functions.sh
. /lib/mediatek.sh
. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

mediatek_setup_interfaces()
{
	local board="$1"

	case "$board" in
	R2 | R9 | R19 | R25)
		ucidef_add_switch "switch0" \
			"0:lan" "1:lan" "2:lan" "4:lan" "3:wan" "6@eth0"
		;;
	R4 | R7 | R26)
		ucidef_add_switch "switch0" \
			"0:lan:3" "1:lan:2" "2:lan:1" "3:lan:0" "4:wan" "6@eth0"
		;;
	R10 | R23 | R29)
		ucidef_set_interfaces_lan_wan "eth0" "eth1"
		ucidef_add_switch "switch0" \
			"0:lan:3" "1:lan:2" "2:lan:1" "3:lan:0" "4:wan" "6@eth0" "5@eth1"
		;;
	MT7621 | R11 | R13 | R15 | R16 | R17 | R18 | R27 | R28 | R30 | R33 | R37 | R47 | R40 | R3 | R45)
		ucidef_set_interfaces_lan_wan "eth0" "eth1"
		ucidef_add_switch "switch0" \
			"0:lan" "1:lan" "2:lan" "3:lan" "4:wan" "6@eth0" "5@eth1"
		;;
	R20 | R24)
		ucidef_set_interfaces_lan_wan "eth0" "eth1"
		ucidef_add_switch "switch0" \
			"0:wan" "1:lan" "2:lan" "3:lan" "4:lan" "5@eth1" "6@eth0"
		;;
	*)
		ucidef_add_switch "switch0" \
			"1:lan" "2:lan" "3:lan" "4:lan" "0:wan" "6@eth0"
		;;
	esac
}

board_config_update
board=$(mediatek_board_name)
mediatek_setup_interfaces $board
board_config_flush

exit 0
