#!/bin/sh

. /lib/functions/uci-defaults.sh
. /lib/mediatek.sh

set_usb_led() {
	ucidef_set_led_usbdev "usb" "USB" "${1}" "${2:-1-1}"
}

set_wifi_led() {
	ucidef_set_led_netdev "wifi_led" "wifi" "${1}" "${2:-wlan0}"
}

board=$(mediatek_board_name)

board_config_update

case $board in
R6 | R8)
	ucidef_set_led_switch "wan" "WAN" "oem:green:wan" "switch0" "0x01"
	ucidef_set_led_switch "lan1" "LAN1" "oem:green:lan1" "switch0" "0x02"
	ucidef_set_led_switch "lan2" "LAN2" "oem:green:lan2" "switch0" "0x04"
	ucidef_set_led_switch "lan3" "LAN3" "oem:green:lan3" "switch0" "0x10"
	set_wifi_led "oem:green:wifi" "ra0"
	;;
R9 | R19 | R25)
	ucidef_set_led_switch "lan1" "LAN1" "oem:green:lan1" "switch0" "0x01"
	ucidef_set_led_switch "lan2" "LAN2" "oem:green:lan2" "switch0" "0x02"
	ucidef_set_led_switch "lan3" "LAN3" "oem:green:lan3" "switch0" "0x04"
	ucidef_set_led_switch "lan4" "LAN4" "oem:green:lan4" "switch0" "0x08"
	set_wifi_led "oem:green:wifi" "ra0"
	;;
R17 | R28)
	ucidef_set_led_switch "lan1" "LAN1" "oem:green:lan3" "switch0" "0x02"
	ucidef_set_led_switch "lan2" "LAN2" "oem:green:lan2" "switch0" "0x04"
	ucidef_set_led_switch "lan3" "LAN3" "oem:green:lan1" "switch0" "0x08"
	ucidef_set_led_switch "lan4" "LAN4" "oem:green:lan4" "switch0" "0x10"
	set_wifi_led "oem:green:wifi" "ra0"
	;;
R7 | R11 | R15 | R16 | R22 | R26)
	ucidef_set_led_switch "lan1" "LAN1" "oem:green:lan1" "switch0" "0x01"
	ucidef_set_led_switch "lan2" "LAN2" "oem:green:lan2" "switch0" "0x02"
	ucidef_set_led_switch "lan3" "LAN3" "oem:green:lan3" "switch0" "0x04"
	ucidef_set_led_switch "lan4" "LAN4" "oem:green:lan4" "switch0" "0x08"
	ucidef_set_led_switch "wan" "WAN" "oem:green:wan" "switch0" "0x10"
	set_wifi_led "oem:green:wifi" "ra0"
	;;
R4)
	ucidef_set_led_switch "lan" "LAN" "oem:green:lan" "switch0" "0x04"
	ucidef_set_led_switch "wan" "WAN" "oem:green:wan" "switch0" "0x10"
	set_wifi_led "oem:green:wifi" "ra0"
	;;
R14)
	ucidef_set_led_switch "lan" "LAN" "oem:green:lan" "switch0" "0x08"
	set_wifi_led "oem:green:wifi" "ra0"
	;;
R31)
        ucidef_set_led_netdev "wifi_led_5g" "wifi5g" "oem:green:wifi5g" "rax0"
        ucidef_set_led_netdev "wifi_led" "wifi" "oem:green:wifi" "ra0" 
	;;
R59)
	ucidef_set_led_netdev "wifi_led_5g" "wifi5g" "oem:green:wifi5g" "rax0" "link"
	ucidef_set_led_netdev "wifi_led_2g" "wifi2g" "oem:green:wifi" "ra0" "link"
	;;
R63 | R57)
	ucidef_set_led_switch "lan1" "LAN1" "oem:green:lan1" "switch0" "0x08"
	ucidef_set_led_switch "lan2" "LAN2" "oem:green:lan2" "switch0" "0x04"
	ucidef_set_led_switch "lan3" "LAN3" "oem:green:lan3" "switch0" "0x02"
	ucidef_set_led_switch "lan4" "LAN4" "oem:green:lan4" "switch0" "0x01"
	ucidef_set_led_netdev "wifi_led_5g" "wifi5g" "oem:green:wifi5g" "rax0" "link"
	ucidef_set_led_netdev "wifi_led_2g" "wifi2g" "oem:green:wifi" "ra0" "link"
	;; 
*)
	set_wifi_led "oem:green:wifi" "ra0"
	;;
esac

board_config_flush

exit 0
