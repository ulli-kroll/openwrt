&CLK_TEST_GCC_SNOC_BUS_TIMEOUT1_AHB_CLK=(&CLK_GCC_TEST|0x171)
&CLK_TEST_GCC_SNOC_BUS_TIMEOUT2_AHB_CLK=(&CLK_GCC_TEST|0x172)
&CLK_TEST_GCC_SPDM_SNOC_CY_CLK=(&CLK_GCC_TEST|0x134)
&CLK_TEST_GCC_SYS_NOC_AXI_CLK=(&CLK_GCC_TEST|0x000)
&CLK_TEST_GCC_SYS_NOC_LPASS_CLK=(&CLK_GCC_TEST|0x007)
&CLK_TEST_GCC_SYS_NOC_TPRB_CLK=(&CLK_GCC_TEST|0x1E6)
&CLK_TEST_GCC_SYS_NOC_WCSS_CLK=(&CLK_GCC_TEST|0x005)
&CLK_TEST_GCC_WCSS_AHB_S0_CLK=(&CLK_GCC_TEST|0x0B0)
&CLK_TEST_GCC_WCSS_AXI_M_CLK=(&CLK_GCC_TEST|0x0B1)
&CLK_TEST_GCC_WCSS_ECAHB_CLK=(&CLK_GCC_TEST|0x0B2)
