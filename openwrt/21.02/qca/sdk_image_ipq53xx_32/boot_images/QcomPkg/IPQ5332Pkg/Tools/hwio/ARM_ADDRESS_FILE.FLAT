-- MODULE MIAMI.LPASS.LPASS_AHBI_TIME (level 2)
----------------------------------------------------------------------------------------
lpass_ahbi_time MODULE OFFSET=LPASS+0x0022D000 MAX=LPASS+0x0022DFFF APRE=LPASS_AHBI_ SPRE=LPASS_AHBI_ RETENTION

ABT_HW_VERSION ADDRESS 0x0000 R RETENTION
ABT_HW_VERSION RESET_VALUE 0x10000000
	MAJOR BIT[31:28] R   RETENTION 
	MINOR BIT[27:16] R   RETENTION 
	STEP BIT[15:0] R   RETENTION 

ABT_INST_ID ADDRESS 0x0004 RW RETENTION
ABT_INST_ID RESET_VALUE 0x00000000
	INSTID BIT[31:0] RW   RETENTION 

ABT_NUM_SLAVES ADDRESS 0x0008 R RETENTION
ABT_NUM_SLAVES RESET_VALUE 0x00000009
