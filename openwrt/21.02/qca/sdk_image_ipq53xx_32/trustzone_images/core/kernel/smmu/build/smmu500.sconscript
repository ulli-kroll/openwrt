import os

#------------------------------------------------------------------------------
# SMMU Lib
#------------------------------------------------------------------------------
Import('env')
env = env.Clone()

#------------------------------------------------------------------------------
# Source PATH
#------------------------------------------------------------------------------
SRCPATH = "../smmu500"

env.VariantDir('${BUILDPATH}', SRCPATH, duplicate=0) 
#------------------------------------------------------------------------------
# Internal depends within CoreBSP
#------------------------------------------------------------------------------
CBSP_APIS = [
   'QSEE_INCLUDE',
   'BUSES',
   'DAL',
   'HAL',
   'SERVICES',
   'SYSTEMDRIVERS',
   'KERNEL',
]

env.RequirePublicApi(CBSP_APIS, area = 'core')
env.RequireRestrictedApi(CBSP_APIS)


SSG_API = [
    'AC',
    'SECUREMSM',
    'MINK',
    'SSGPLATFORM',
    'TZCHIPSET',
]
env.RequirePublicApi(SSG_API, area = 'ssg')

#------------------------------------------------------------------------------
# Internal depends within subunit
#------------------------------------------------------------------------------

env.PublishPrivateApi('SMMU_500', [
   '${INC_ROOT}/core/kernel/smmu/smmu500/src',
   '${INC_ROOT}/core/kernel/smmu/smmu500/${SMMU_MSM_ID}/tz',
   '${INC_ROOT}/core/kernel/smmu/smmu500/inc', 
])
INC_PATH = [
   '${BUILD_ROOT}/core/kernel/smmu/smmu500/src',
   '${INC_ROOT}/core/kernel/smmu/smmu500/inc', 
#   '${INC_ROOT}/core/api/systemdrivers/', 
]
env.Append(CPPPATH=INC_PATH)

#------------------------------------------------------------------------------
# Compiler options
#------------------------------------------------------------------------------
#env.Append(CCFLAGS = "--gnu")

#------------------------------------------------------------------------------
# Sources, libraries
#------------------------------------------------------------------------------
#TZ side
SMMU_SOURCES = [
   '${BUILDPATH}/src/SMMUInit.c',
   '${BUILDPATH}/${SMMU_MSM_ID}/tz/SMMUTrustZone.c',
   '${BUILDPATH}/src/SMMUTranslation.c',
   '${BUILDPATH}/src/SMMU_TZ_CE_PolicyMgr.c',
   '${BUILDPATH}/${SMMU_MSM_ID}/tz/SMMUClock.c',
   '${BUILDPATH}/${SMMU_MSM_ID}/tz/SMMUSafeEcoUtils.c',   
]
#HYP side
SMMU_HYP_SOURCES = [
   '${BUILDPATH}/src/SMMU_vm.c',
#   '${BUILDPATH}/src/SMMU_vm_secdisp.c',
#   '${BUILDPATH}/src/SMMUVirtualization.c',
   '${BUILDPATH}/${SMMU_MSM_ID}/hyp/SMMUInit.c',
   '${BUILDPATH}/${SMMU_MSM_ID}/hyp/SMMUHypervisor.c',
   '${BUILDPATH}/${SMMU_MSM_ID}/hyp/SMMUVirtBuffer.c',
   '${BUILDPATH}/${SMMU_MSM_ID}/hyp/SMMUTranslation.c',
#   '${BUILDPATH}/${SMMU_MSM_ID}/hyp/SMMU_Dynamic_SID2VMID.c'
#   '${BUILDPATH}/src/SMMUInternal.h',
]
SMMU_COMMON_SOURCES = [
   '${BUILDPATH}/src/HALSMMU.c',
#   '${INC_ROOT}/core/systemdrivers/clock/src/ClockDriver.c',
]
HAL_SMMU_PACKOUT_HEADER_FILES = [
   '${BUILDPATH}/src/HALSMMU.h',
   '${BUILDPATH}/src/SMMUInternal.h',
   '${BUILDPATH}/${SMMU_MSM_ID}/hyp/SMMUVirtBuffer.h',
]

SMMU_TARGET_SOURCES = [
   '${BUILDPATH}/${SMMU_MSM_ID}/SMMUConfig.c',
   '${BUILDPATH}/${SMMU_MSM_ID}/SMMUConfigInfo.c',
]
HAL_SMMU_PACKOUT_SOURCE_FILES = env.FindFiles(
   '*.c',
   '${INC_ROOT}/core/kernel/smmu/smmu500/')


env.AddBinaryLibrary(['TZOS_IMAGE'], '${BUILDPATH}/SMMUTzos', [SMMU_COMMON_SOURCES,SMMU_SOURCES,SMMU_TARGET_SOURCES])
env.AddBinaryLibrary(['HYPERVISOR_IMAGE','TZBSPTEST_IMAGE'], '${BUILDPATH}/SMMUHYPOS',
                    [SMMU_COMMON_SOURCES,SMMU_TARGET_SOURCES,SMMU_HYP_SOURCES,HAL_SMMU_PACKOUT_HEADER_FILES])

ALL_SRC = env.FindFiles(['*.c'], "${BUILD_ROOT}/core/kernel/smmu/")
CLEAN_SOURCES = list(set(ALL_SRC) - set(SMMU_SOURCES))
env.CleanPack(['TZOS_IMAGE', 'HYPERVISOR_IMAGE'], CLEAN_SOURCES)
env.CleanPack(['TZOS_IMAGE','HYPERVISOR_IMAGE'],
              HAL_SMMU_PACKOUT_HEADER_FILES)

env.CleanPack(['TZOS_IMAGE','HYPERVISOR_IMAGE'],
              HAL_SMMU_PACKOUT_SOURCE_FILES)

