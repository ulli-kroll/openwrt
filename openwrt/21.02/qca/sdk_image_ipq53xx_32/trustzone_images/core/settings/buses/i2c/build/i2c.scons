import os
Import('env')

#-------------------------------------------------------------------------------
# Load sub scripts
#-------------------------------------------------------------------------------

if env['TARGET_FAMILY'] in ['badger', 'honeybadger', 'bear']:
   env.LoadSoftwareUnits(dir_patterns='../blsp/build')
elif env['TARGET_FAMILY'] in ['hoya', 'bruin']:
   if env['CHIPSET'] in ['sdx24']:
      env.LoadSoftwareUnits(dir_patterns='../blsp/build')
   else:
      env.LoadSoftwareUnits(dir_patterns='../qupv3/build')
