import os

Import('env')


env.PublishPublicApi('KP', [
   '${INC_ROOT}/ssg/api/securemsm/kernelprotect',
])

env.PublishRestrictedApi('KP', [
   '${BUILD_ROOT}/ssg/securemsm/kernelprotect/inc',
])

env.LoadAPIUnits()
env.Deploy('kp.api')
