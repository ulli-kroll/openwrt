Import('env')
env = env.Clone()

#Find PLATFORM_CPUS / different ARM/QCOM implemented CPU used in the target.
env.SConscript('arch.scons', exports='env')

env.LoadSoftwareUnits()
env.Append(CFLAGS = " -Werror ")

