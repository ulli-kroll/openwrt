Import('env')
env = env.Clone()


SOURCES = [ '../src/sselog.c',]

includes = ["../inc",
            "../../common/include",]
    
sselog_lib = env.SecureAppLibBuilder(includes, SOURCES, 'sselog')
env.DeploySdkLib(sselog_lib)
env.Deploy(['SConscript',sselog_lib])

env.Deploy(Glob('../inc/*.h') +
           Glob('../../common/include/*.h'))
          
Return('sselog_lib')
