from SCons.Script import BUILD_TARGETS

Import('env')

pyfiles = env.Glob('scripts/*.py')
ldfiles = env.Glob('scripts/*.ld')
txtfiles = env.Glob('scripts/*.txt')
bin_files = ['scripts/bin/linux/minkidl', 'scripts/bin/win/minkidl.exe']
if env['CHIPSET'] in ['ipq90xx']:
   xmlprofilefiles = ['../../Alder_tz_security_profile.xml']
else:
   xmlprofilefiles = ['../../Miami_tz_security_profile.xml']
env.Deploy(pyfiles + ldfiles + txtfiles + bin_files + xmlprofilefiles)

