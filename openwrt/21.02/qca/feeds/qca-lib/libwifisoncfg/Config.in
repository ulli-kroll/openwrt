# LIBWIFISONCFG configs
config LIBCFG80211_SUPPORT
	bool "libwifison CFG80211 support"
	depends on PACKAGE_qca-cfg80211
	default y
	help
		Enable CFG80211 support for libwifisoncfg library

config WIFISON_SUPPORT_ATH10K
	bool "Support ATH10K"
	depends on PACKAGE_kmod-mac80211&&!CONFIG_WIFISON_SUPPORT_QSDK
	default y
	help
		This enables SON Libraries support for Ath10k driver

config WIFISON_SUPPORT_QSDK
	bool "Support QSDK"
	depends on PACKAGE_kmod-qca-wifi-unified-profile||PACKAGE_kmod-qca-wifi-custc-profile||PACKAGE_kmod-qca-wifi-lowmem-profile||PACKAGE_kmod-qca-wifi-akronite-perf||PACKAGE_kmod-qca-wifi-dakota-perf||PACKAGE_kmod-qca-wifi-perf||PACKAGE_kmod-qca-wifi-unified-perf&&!CONFIG_WIFISON_SUPPORT_ATH10K||PACKAGE_kmod-qca-wifi-flash_16mb-profile||PACKAGE_kmod-qca-wifi-unified-profile-nonss||PACKAGE_kmod-qca-wifi-lowmem-profile-nonss||PACKAGE_kmod-qca-wifi-wkk-profile
	default y
	help
		This enables SON Libraries support for Qualcomm Technologies Inc driver

config WIFISON_SUPPORT_11BE
	bool "Support for 11BE in libwifisoncfg"
	depends on PACKAGE_kmod-qca-wifi-perf||PACKAGE_kmod-qca-wifi-unified-perf||PACKAGE_kmod-qca-wifi-unified-profile||PACKAGE_kmod-qca-wifi-custc-profile||PACKAGE_kmod-qca-wifi-unified-profile-nonss||PACKAGE_kmod-qca-wifi-wkk-profile||PACKAGE_kmod-qca-wifi-lowmem-profile||PACKAGE_kmod-qca-wifi-lowmem-profile-nonss
	default y
	help
		This enables the 11BE support

config WIFISON_MODULE_PUNCTURE
    bool "Enable puncturing support in ezmesh"
    depends on PACKAGE_kmod-qca-wifi-akronite-perf||PACKAGE_kmod-qca-wifi-dakota-perf||PACKAGE_kmod-qca-wifi-perf||PACKAGE_kmod-qca-wifi-unified-perf||PACKAGE_kmod-qca-wifi-unified-profile||PACKAGE_kmod-qca-wifi-custc-profile||PACKAGE_kmod-qca-wifi-flash_16mb-profile||PACKAGE_kmod-qca-wifi-unified-profile-nonss||PACKAGE_kmod-qca-wifi-wkk-profile||PACKAGE_kmod-qca-wifi-lowmem-profile||PACKAGE_kmod-qca-wifi-lowmem-profile-nonss
    default y
    help
      puncturing support for ezmesh
