config wifi-device  wifiX
        option type     qcawificfg80211
        option channel  auto
        option macaddr  aa:bb:cc:dd:ee:ff
        option hwmode   11bea
        # REMOVE THIS LINE TO ENABLE WIFI:
        option disabled 1

config wifi-iface
        option device   wifiX
        option network  lan
        option mode     ap
        option ssid     QSoftAP_6G
        option encryption ccmp
        option sae      1
        option sae_pwe  1
        list sae_password 1234567890
        option athnewind 1
        option disabled 1

