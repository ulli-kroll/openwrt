
config wifi-device 'radio0'
	option type 'qcawificfg80211'
	option phy 'wifi0'
	option dbdc_enable '0'
	option delay_stavapup '0'
	option hwmodes '11bgnaxbe'
	option htbw 'auto'
	option country 'DE'
	option hwmode '11bgnaxbe'
	option channel 'auto'
	option txpower '100'
	option no_vlan '1'
	option disabled '0'

config wifi-iface 'wlan00'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ifname 'ath0'
	option mcastenhance '2'
	option macfilter 'deny'
	option wps_pbc '1'
	option rrm '1'
	option wnm '1'
	option i18name '2.4G'
	option encryption 'none'
	option ssid 'Cudy-R65-9300'

config wifi-iface 'wlan01'
	option device 'radio0'
	option i18name '2.4G'
	option ifname 'ath01'
	option mode 'sta'
	option extap '1'
	option ssid 'Cudy-default'
	option encryption 'none'
	option network 'wan'
	option mld 'mld1'
	option disabled '1'

config wifi-iface 'wlan02'
	option device 'radio0'
	option i18name '2.4G'
	option ifname 'ath02'
	option mode 'ap'
	option ssid 'Cudy-Guest-2.4G'
	option encryption 'none'
	option macfilter 'deny'
	option multissid '1'
	option network 'lan'
	option disabled '1'

config wifi-iface 'wlan03'
	option device 'radio0'
	option i18name '2.4G'
	option ifname 'ath03'
	option network 'lan'
	option mode 'ap'
	option addr4 '1'
	option encryption 'psk2'
	option macfilter 'deny'
	option multissid '1'
	option hidden '1'
	option ssid 'Cudy-default'
	option key '12345678'
	option mld 'mld2'

config wifi-iface 'wlan04'
	option device 'radio0'
	option i18name '2.4G'
	option ifname 'ath04'
	option network 'lan'
	option mode 'ap'
	option ssid 'Cudy-MLO'
	option encryption 'none'
	option macfilter 'deny'
	option multissid '1'
	option mld 'mld0'
	option disabled '1'

config wifi-device 'radio1'
