	option device 'radio1'
	option i18name '5G'
	option ifname 'ath1'
	option network 'lan'
	option mode 'ap'
	option mcastenhance '2'
	option macfilter 'deny'
	option wps_pbc '1'
	option rrm '1'
	option wnm '1'
	option encryption 'none'
	option ssid 'Cudy-R65-5G-9300'

config wifi-iface 'wlan11'
	option device 'radio1'
	option i18name '5G'
	option ifname 'ath11'
	option mode 'sta'
	option extap '1'
	option ssid 'Cudy-default-5G'
	option encryption 'none'
	option network 'wan'
	option mld 'mld1'
	option disabled '1'

config wifi-iface 'wlan12'
	option device 'radio1'
